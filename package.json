{
  "name": "cf-monitor-theme-hahaha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/licenses.mjs && node scripts/check-dist.mjs",
    "build:github-page": "vue-tsc --noEmit && vite build --mode static && node scripts/licenses.mjs && node scripts/check-dist.mjs",
    "format": "prettier --write src scripts *.ts *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "papercss": "^1.9.2",
    "roughjs": "^4.6.6",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "wired-elements": "^3.0.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
